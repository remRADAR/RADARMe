{
  "name": "RADARMe: The iNDUSTRYKit",
  "short_name": "RADARMe",
  "description": "The premium operating system for music artists by RADARCharts.",
  "start_url": "/",
  "scope": "/",
  "id": "https://remradar-radarme.remradar.workers.dev/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
